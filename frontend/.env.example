# ==============================================================================
# Planeta Huella (Frontend PWA) - Plantilla de Variables de Entorno
# Copia este archivo como `.env` dentro de `frontend/`
# ==============================================================================

# URL base de la API REST del backend
VITE_API_URL=http://localhost:3000/api

# ==============================================================================
# Credenciales públicas OAuth 2.0 para inicio de sesión con Google
# ==============================================================================
# ID de Cliente Web de Google Cloud Console (ej. 123456-abc.apps.googleusercontent.com)
VITE_GOOGLE_CLIENT_ID=
