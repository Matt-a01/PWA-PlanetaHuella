# ==============================================================================
# Planeta Huella (Backend API) - Plantilla de Variables de Entorno
# Copia este archivo como `.env` dentro de `backend/` y configura tus valores
# ==============================================================================

# Puerto HTTP del servidor Express
PORT=3000

# Cadena de conexión al clúster de MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/planeta_huella

# Secreto criptográfico para firmar y verificar tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=reemplazar_por_secreto_aleatorio_minimo_32_caracteres

# Orígenes permitidos para peticiones CORS (separados por coma si existen varios)
CORS_ORIGIN=http://localhost:5173
