# ==============================================================================
# Planeta Huella (Backend API) - Plantilla de Variables de Entorno
# Copia este archivo como `.env` dentro de `backend/` y configura tus valores
# ==============================================================================

# Puerto HTTP del servidor Express
PORT=3000

# Cadena de conexión al clúster de MongoDB Atlas
MONGO_URI=mongodb+srv://<usuario>:<password>@cluster.mongodb.net/planeta_huella

# Secreto criptográfico para firmar y verificar tokens JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=reemplazar_por_secreto_aleatorio_minimo_32_caracteres

# Orígenes permitidos para peticiones CORS (separados por coma si existen varios)
CORS_ORIGIN=http://localhost:5173

# ==============================================================================
# Correo Electrónico Transaccional (Verificación OTP y Recuperación de Contraseña)
# Puedes usar SMTP directo (ej. Gmail Contraseña de Aplicación) o API HTTPS (Resend/Brevo).
# Si se dejan vacíos en desarrollo, el sistema opera en Modo Previsualización.
# ==============================================================================
EMAIL_FROM=Planeta Huella <no-reply@planetahuella.app>

# Opción A: Servidor SMTP (ej. Gmail: smtp.gmail.com, puerto 465)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Opción B: API HTTP Transaccional (Recomendado para Render Free Tier por puerto 443)
RESEND_API_KEY=
BREVO_API_KEY=

# ==============================================================================
# Inicio de Sesión Social OAuth 2.0 / OIDC (Google)
# ==============================================================================
GOOGLE_CLIENT_ID=
